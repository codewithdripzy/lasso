{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    // "module": "CommonJS",
    "module": "NodeNext",
    // "moduleResolution": "node",
    // "module": "ESNext", //
    // "moduleResolution": "Bundler", //
    "lib": ["ES2022"],
    "types": ["node"],
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.cli.tsbuildinfo", //
    "outDir": "../dist", //
    "rootDir": "../src", //
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["../src/cli/**/*", "../src/runtime/**/*", "../src/core/interfaces/**/*"] //
}
